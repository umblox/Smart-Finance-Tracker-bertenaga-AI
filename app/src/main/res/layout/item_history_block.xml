<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_color"
    app:cardBackgroundColor="@color/surface_white"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER TANGGAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHeaderDateNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="27"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderDayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Hari ini"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvHeaderMonthYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Juli 2026"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeaderDailyTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="-Rp 59.500"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"/>

        <!-- CONTAINER TRANSAKSI -->
        <!-- Di sinilah Kotlin akan menyuntikkan item-item transaksi harian -->
        <LinearLayout
            android:id="@+id/containerTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
